<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>Activate your UaMed account</title>
  </head>

  <body
    style='margin: 0; padding: 0; background-color: #f8faf9; font-family: Arial, Helvetica, sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color: #f8faf9; padding: 40px 0;'
    >
      <tr>
        <td align='center' style='padding: 0 16px;'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            style='width: 100%; max-width: 600px; background-color: #ffffff; border-radius: 18px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 16px 48px rgba(15, 23, 42, 0.08);'
          >
            <tr>
              <td
                style='padding: 36px 40px; text-align: center; background: linear-gradient(135deg, #10b981, #047857);'
              >
                <h1
                  style='margin: 0; color: #ecfdf5; font-size: 30px; font-weight: 800; letter-spacing: -0.03em;'
                >
                  UaMed
                </h1>

                <p style='margin: 8px 0 0; color: #d1fae5; font-size: 14px; line-height: 1.5;'>
                  Medical service platform
                </p>
              </td>
            </tr>

            <tr>
              <td style='padding: 42px 40px 36px;'>
                <div
                  style='display: inline-block; padding: 6px 12px; background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 999px; color: #065f46; font-size: 13px; font-weight: 700; margin-bottom: 20px;'
                >
                  Account activation
                </div>

                <h2
                  style='margin: 0 0 16px; color: #111827; font-size: 26px; line-height: 1.25; font-weight: 800; letter-spacing: -0.03em;'
                >
                  Activate your UaMed account
                </h2>

                <p style='margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.65;'>
                  Hello,
                  <strong style='color: #111827;'>{{userName}}</strong>.
                </p>

                <p style='margin: 0 0 26px; color: #374151; font-size: 16px; line-height: 1.65;'>
                  Thank you for registering in UaMed. To complete your registration and start using
                  your account, please confirm your email address by clicking the button below.
                </p>

                <div style='text-align: center; margin: 34px 0;'>
                  <a
                    href='{{activationLink}}'
                    style='display: inline-block; padding: 15px 30px; background-color: #047857; color: #ffffff; text-decoration: none; border-radius: 10px; font-size: 16px; font-weight: 700; box-shadow: 0 12px 28px rgba(4, 120, 87, 0.24);'
                  >
                    Activate account
                  </a>
                </div>

                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 12px; margin: 0 0 24px;'
                >
                  <tr>
                    <td style='padding: 16px 18px;'>
                      <p style='margin: 0; color: #065f46; font-size: 14px; line-height: 1.6;'>
                        This link is used only to verify your email address and activate your
                        account.
                      </p>
                    </td>
                  </tr>
                </table>

                <p style='margin: 0; color: #6b7280; font-size: 14px; line-height: 1.6;'>
                  If you did not create an account, you can safely ignore this email.
                </p>
              </td>
            </tr>

            <tr>
              <td
                style='padding: 24px 40px; background-color: #f9fafb; border-top: 1px solid #e5e7eb; text-align: center;'
              >
                <p style='margin: 0 0 6px; color: #374151; font-size: 13px; font-weight: 700;'>
                  UaMed
                </p>

                <p style='margin: 0; color: #9ca3af; font-size: 12px; line-height: 1.5;'>
                  This is an automatic email, please do not reply.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
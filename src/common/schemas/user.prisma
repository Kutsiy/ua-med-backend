model User {
  id            String    @id @unique
  firstName     String
  secondName    String
  middleName    String?
  birthDate     DateTime?
  email         String    @unique
  phoneNumber   String?   @unique
  password      String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? 
  bannedAt      DateTime?
  lastOnlineAt  DateTime?
  refreshTokens RefreshToken[]

  accounts OAuthAccount[]

  @@map("user")
}